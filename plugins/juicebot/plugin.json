{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "juicebot",
  "version": "1.3.1",
  "description": "AI control of the Juicebox Hi-C contact-map viewer: search ENCODE/4DN, load maps and tracks, navigate loci, compare panels, share sessions. Connects to the Aiden Lab's hosted MCP server; nothing runs locally.",
  "author": {
    "name": "The Aiden Lab",
    "url": "https://aidenlab.org"
  },
  "homepage": "https://github.com/weiszd/juicebox-mcp",
  "repository": "https://github.com/aidenlab/plugins",
  "license": "MIT",
  "keywords": [
    "hi-c",
    "juicebox",
    "genomics",
    "3d-genome",
    "chromatin",
    "encode",
    "4dn",
    "mcp"
  ],
  "skills": "./skills/",
  "mcpServers": "./mcp.json",
  "extensions": {
    "com.openai": {
      "displayName": "JuiceBot",
      "category": "Science",
      "interface": {
        "composerIcon": "./assets/icon-128.png",
        "logo": "./assets/icon.png",
        "brandColor": "#e8231b"
      }
    }
  }
}
